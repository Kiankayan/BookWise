
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LibraryItemType {
  BOOK
  DVD
  AUDIOBOOK
  REFERENCE_BOOK
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  libraryItems LibraryItem[]
}

model LibraryItem {
  id             String          @id @default(cuid())
  title          String
  author         String?
  nbrPages       Int?
  runTimeMinutes Int?
  type           LibraryItemType
  isBorrowable   Boolean
  borrower       String?
  borrowDate     DateTime?
  dueDate        DateTime?
  categoryId     String
  imageUrl       String?


  category       Category @relation(fields: [categoryId], references: [id])
}
